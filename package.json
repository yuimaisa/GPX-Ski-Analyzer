{
  "name": "gpx-ski-analyzer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ブラウザ内でGPXのスキー記録を解析する静的Webアプリ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuimaisa/GPX-Ski-Analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/yuimaisa/GPX-Ski-Analyzer/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/build-worker.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
